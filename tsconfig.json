{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strict": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": [
			"DOM",
			"ES5",
			"ES6",
			"ES7",
			"ES2018",
			"ES2019",
			"ES2020",
			"ESNext"
		],
		"types": [
			"node",
			"obsidian"
		]
	},
	"include": [
		"src/**/*.ts"
	]
}
