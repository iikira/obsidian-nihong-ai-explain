{
	"name": "obsidian-nihong-ai-explain",
	"version": "0.1.6",
	"description": "Select a Japanese word or sentence, and the AI generates detailed notes, grammar breakdowns, translations, offline dictionary lookups, and audio pronunciation.",
	"main": "main.js",
	"type": "commonjs",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"prepare-accents": "node esbuild.config.mjs --prepare-accents",
		"build": "npm run prepare-accents && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "npm run prepare-accents && tsc -noEmit -skipLibCheck",
		"test": "node test/build.mjs && node --test test-dist/*.test.cjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"japanese",
		"ai"
	],
	"author": "iikira",
	"license": "GPL-3.0-only",
	"dependencies": {
		"fflate": "^0.8.2",
		"idb": "^8.0.0"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.2",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"fake-indexeddb": "^6.2.7",
		"obsidian": "^1.5.7",
		"sass": "^1.107.0",
		"typescript": "^5.4.0"
	}
}
