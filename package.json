{
	"name": "obsidian-nihong-ai-explain",
	"version": "0.1.0",
	"description": "选中日语单词或句子，AI 讲解生成详解笔记、翻译、离线查词典与朗读。",
	"main": "main.js",
	"type": "commonjs",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "node test/build.mjs && node --test test-dist/*.test.cjs"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"japanese",
		"ai"
	],
	"author": "iikira",
	"license": "GPL-3.0-only",
	"dependencies": {
		"fflate": "^0.8.2",
		"idb": "^8.0.0"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.20.2",
		"obsidian": "^1.5.7",
		"typescript": "^5.4.0"
	}
}
